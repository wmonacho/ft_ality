UP = w
DOWN = s
LEFT = a
RIGHT = d
PUNCH = p
KICK = k
KICK2 = i

Uppercut = DOWN + DOWN
Upperkick = DOWN , UP , KICK
Hook = RIGHT + PUNCH
Lowkick = DOWN+KICK+UP
Highkick = UP + KICK
Reversekick = LEFT , UP , KICK
Reversekick2 = LEFT , UP , PUNCH
Reversekick = LEFT , UP , PUNCH
MOVEA = RIGHT
MOVEB = RIGHT , UP
MOVEC = RIGHT , UP , DOWN
